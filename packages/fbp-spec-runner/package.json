{
  "name": "@noflo/fbp-spec-runner",
  "version": "2.0.0-alpha.1",
  "description": "In-process fbp-spec test runner for NoFlo components, built on node:test",
  "keywords": [
    "fbp",
    "flowbased",
    "noflo",
    "testing",
    "fbp-spec"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@noflo/loader-node": "^2.0.0-alpha.1",
    "@noflo/noflo": "^2.0.0-alpha.1"
  },
  "bin": {
    "fbp-spec-runner": "./src/cli.js"
  },
  "files": [
    "src",
    "vendor",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/noflo/noflo.git"
  },
  "scripts": {
    "test": "node --test spec/*.js",
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/ spec/ utils/",
    "types": "tsc --checkJs --noEmit -p .",
    "test:deno": "deno test --allow-all --no-check spec/*.js",
    "test:bun": "bun test ./spec/*.js"
  }
}
