{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": false,
    "allowJs": true,
    "strict": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "."
  },
  "include": ["src/**/*.js"],
  "exclude": ["../**/vendor/**", "vendor/**/*.d.ts", "src/**/*.d.ts"]
}
