{
  "name": "@noflo/fbp-protocol",
  "version": "2.0.0-alpha.2",
  "description": "FBP Protocol 2.0 over Reticulum: wire-format constants and codecs for the runtime protocol",
  "keywords": [
    "fbp",
    "noflo",
    "reticulum",
    "protocol",
    "msgpack"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "asyncapi.json",
    "CHANGELOG.md",
    "SPEC.md"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/noflo/noflo.git"
  },
  "scripts": {
    "test": "node --test spec/*.js",
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/ spec/",
    "types": "find src -name '*.d.ts' -delete && tsc -p tsconfig.json",
    "test:deno": "deno test --allow-all --no-check spec/*.js",
    "test:bun": "bun test ./spec/*.js"
  },
  "dependencies": {
    "@reticulum/core": "^0.9.7"
  }
}
