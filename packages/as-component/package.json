{
  "name": "@noflo/as-component",
  "version": "2.0.0-alpha.0",
  "description": "Generate NoFlo components from JavaScript functions",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/ spec/",
    "test": "node --test --test-force-exit --test-timeout 30000 spec/*.js",
    "types": "tsc --noEmit -p tsconfig.json",
    "test:deno": "deno test --allow-all --no-check spec/*.js",
    "test:bun": "bun test ./spec/*.js"
  },
  "keywords": [
    "noflo",
    "flow-based programming",
    "fbp"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">= 22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo.git"
  },
  "bugs": {
    "url": "https://github.com/noflo/noflo/issues"
  },
  "peerDependencies": {
    "@noflo/noflo": "*"
  },
  "dependencies": {
    "get-function-params": "^2.0.6"
  },
  "devDependencies": {
    "@noflo/noflo": "*"
  }
}
