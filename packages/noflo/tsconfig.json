{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "checkJs": true,
    "skipLibCheck": true,
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "./types",
    "strict": false
  },
  "include": ["src/*.js", "src/**/*.js"],
  "exclude": ["node_modules", "spec"]
}
