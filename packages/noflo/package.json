{
  "name": "@noflo/noflo",
  "description": "Flow-Based Programming environment for JavaScript",
  "keywords": [
    "fbp",
    "workflow",
    "flow",
    "noflo"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "version": "2.0.0-alpha.3",
  "license": "MIT",
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@noflo/graph": "^2.0.0-alpha.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^4.0.2"
  },
  "main": "./src/lib/NoFlo.js",
  "module": "./src/lib/NoFlo.js",
  "exports": {
    ".": "./src/lib/NoFlo.js"
  },
  "types": "./src/lib/NoFlo.d.ts",
  "bin": {
    "noflo": "./bin/noflo"
  },
  "homepage": "http://noflojs.org/",
  "repository": {
    "type": "git",
    "url": "git://github.com/noflo/noflo.git"
  },
  "rngit": "rns://3ea5aad068a337670f5bb8073226adb4/public/noflo",
  "scripts": {
    "lint": "npx @biomejs/biome lint src/ spec/*.js",
    "types": "find src -name '*.d.ts' -delete && tsc -p tsconfig.json",
    "test": "node --test --test-force-exit --test-timeout 30000 spec/*.js",
    "test:deno": "deno test --allow-read=spec,src,CHANGELOG.md --allow-env --no-check spec/*.js",
    "test:bun": "bun test ./spec/*.js"
  },
  "docco_husky": {
    "output_dir": "docs",
    "project_name": "NoFlo"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ]
}
