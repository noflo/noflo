{
  "name": "@noflo/loader-node",
  "version": "2.0.0-alpha.1",
  "description": "Node.js component discovery and source storage for NoFlo, as a ComponentRegistry implementation",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./graphFile": "./src/graphFile.js"
  },
  "bin": {
    "noflo-cache-preheat": "bin/noflo-cache-preheat"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/ spec/",
    "test": "node --test --test-force-exit --test-timeout 30000 spec/*.js",
    "types": "find src -name '*.d.ts' -delete && tsc -p tsconfig.json",
    "test:deno": "deno test --allow-all --no-check spec/*.js",
    "test:bun": "bun test ./spec/*.js"
  },
  "keywords": [
    "noflo",
    "flow-based programming",
    "fbp",
    "component loader"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">= 22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo.git"
  },
  "bugs": {
    "url": "https://github.com/noflo/noflo/issues"
  },
  "peerDependencies": {
    "@noflo/noflo": "^2.0.0-alpha.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@noflo/fbp": "^2.0.0-alpha.1",
    "@noflo/graph": "^2.0.0-alpha.1"
  },
  "devDependencies": {
    "@noflo/noflo": "^2.0.0-alpha.1"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ]
}
